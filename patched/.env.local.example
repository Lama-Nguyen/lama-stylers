# ═══════════════════════════════════════════════════════════
#  Lama Stylers — .env.local.example
#
#  CÁCH DÙNG:
#    1. Đổi tên file này thành .env.local
#    2. Điền giá trị thật vào (xóa comment #, giữ nguyên tên biến)
#    3. KHÔNG commit .env.local lên git (đã có sẵn trong .gitignore)
# ═══════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# 🔴 BẮT BUỘC — App KHÔNG chạy được nếu thiếu phần này
# Lấy 1 lần duy nhất tại:
# Firebase Console → ⚙️ Project Settings → cuộn xuống "Your apps"
# → chọn app Web (biểu tượng </>) → copy object firebaseConfig
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ⚠️ ĐÃ CHUYỂN SANG NETLIFY (trước đó là Vercel — xem
# CHANGELOG_NETLIFY_MIGRATION.md): địa chỉ API server (thay cho Cloud
# Functions). Đây là URL site Netlify của bạn SAU KHI đã deploy, kèm
# "/api" ở cuối (redirect /api/* → /.netlify/functions/:splat đã cấu
# hình sẵn trong netlify.toml, xem file đó).
# Xem hướng dẫn triển khai đầy đủ trong DEPLOY.md.
# Giá trị mặc định (site chưa đổi tên): https://<site-name>.netlify.app/api
VITE_NETLIFY_API_BASE=


# ─────────────────────────────────────────────────────────────
# 🟡 NÊN CÓ — App Check (reCAPTCHA v3)
# ⚠️ LƯU Ý: sau khi chuyển Cloud Functions sang Netlify (trước đó là
# Vercel — cùng hạn chế), App Check KHÔNG CÒN được server-side verify
# (Netlify Functions cũng không có tính năng tương đương
# enforceAppCheck). Biến này vẫn có thể điền (không gây hại), nhưng
# không còn là lớp bảo vệ bắt buộc như trước — xem giải thích đầy đủ
# trong src/services/firebase.js.
# Lấy tại: Firebase Console → App Check → Apps → chọn app Web
# → reCAPTCHA v3 → Register → copy Site Key
# ─────────────────────────────────────────────────────────────
VITE_RECAPTCHA_SITE_KEY=


# ─────────────────────────────────────────────────────────────
# ⚪ TÙY CHỌN — bỏ trống vẫn chạy bình thường, thêm sau cũng được
# ─────────────────────────────────────────────────────────────

# Thông báo đẩy (push notification) — không điền thì app vẫn
# chạy, chỉ là không gửi được thông báo đẩy ra ngoài trình duyệt.
# Lấy tại: Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Thống kê lượt truy cập (Google Analytics) — không cần thiết để vận hành.
VITE_FIREBASE_MEASUREMENT_ID=


# ═══════════════════════════════════════════════════════════
#  ⚠️ CÁC KHOÁ SAU KHÔNG ĐIỀN Ở FILE NÀY
#  Kể từ khi chuyển sang Netlify, các secret dùng cho server (Gemini,
#  SePay, Resend, fal.ai, OpenRouter, Cloudinary...) KHÔNG CÒN set qua
#  `firebase functions:secrets:set` nữa — chúng set qua Netlify
#  Environment Variables (Netlify Dashboard → Site settings →
#  Environment variables, hoặc `netlify env:set`).
#
#  Xem hướng dẫn ĐẦY ĐỦ, CHI TIẾT TỪNG BƯỚC trong file DEPLOY.md
#  ở thư mục gốc — bao gồm danh sách toàn bộ biến cần set, cách lấy
#  từng key, và cách deploy lần đầu.
# ═══════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# 🐞 FEEDBACK TELEGRAM (server-side — set ở Netlify Dashboard)
# TELEGRAM_BOT_TOKEN=<token từ @BotFather>
# TELEGRAM_CHAT_ID=<chat ID nhóm/kênh nhận feedback>
# Hướng dẫn:
#   1. Chat @BotFather trên Telegram → /newbot → lấy token
#   2. Thêm bot vào group, lấy chat_id qua:
#      https://api.telegram.org/bot{TOKEN}/getUpdates
# ─────────────────────────────────────────────────────────────

# ─── AI Providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # Free tier primary — console.cloud.google.com
GEMINI_PRO_API_KEY=              # Premium tier primary — same console
XTROUTER_API_KEY=                # Mistral Medium 3.5 + Large 3 — xkiro.com
OPENROUTER_API_KEY=              # Nemotron + Content Safety — openrouter.ai
REPLICATE_API_KEY=               # Premium fallback — replicate.com

# ─────────────────────────────────────────────────────────────
# 💰 GOOGLE ADSENSE (tùy chọn — bỏ trống thì tắt hoàn toàn, không lỗi)
# Lấy tại: AdSense Dashboard → Ads → By ad unit → Display ads
# ⚠️ Đây là VITE_ vars → phải set ở Netlify Dashboard:
#    Site settings → Build & deploy → Environment variables
#    (KHÔNG phải Functions env vars)
# ─────────────────────────────────────────────────────────────
VITE_ADSENSE_PUBLISHER_ID=      # ca-pub-XXXXXXXXXXXXXXXX (từ AdSense account)
VITE_ADSENSE_REWARDED_SLOT=     # ID của ad unit loại "Rewarded" (tạo trong AdSense)
VITE_ADSENSE_TEST_MODE=true     # true khi dev/staging, false khi production thật
